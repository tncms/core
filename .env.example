APP_NAME="Laravel CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://laravel-cms.demo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel-cms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CMS configuration
CMS_NAME="Laravel CMS"
CMS_ACTIVE_THEME=default
# Deployment mode: public_root | public_html_rewrite
CMS_DEPLOYMENT_MODE=public_root

# Posts Translation Platform (Phase 9.0H). Posts default to the Translation
# Platform adapter path (read + write). To roll back to the legacy path with no
# data migration, uncomment both lines below and clear the config cache.
# CMS_TL_POSTS_READ_DRIVER=legacy
# CMS_TL_POSTS_WRITE_DRIVER=legacy

# Pages Translation Platform (Phase 9.2I). Pages default to the Translation
# Platform adapter path (read + write). To roll back to the legacy path with no
# data migration, uncomment both lines below and clear the config cache.
# CMS_TL_PAGES_READ_DRIVER=legacy
# CMS_TL_PAGES_WRITE_DRIVER=legacy

# Taxonomy Translation Platform (Phase 9.2I). Every taxonomy (category, tag,
# brand, …) defaults to the Translation Platform adapter path (read + write).
# To roll back to the legacy path with no data migration, uncomment both lines
# below and clear the config cache.
# CMS_TL_TERMS_READ_DRIVER=legacy
# CMS_TL_TERMS_WRITE_DRIVER=legacy

# Content Revisions (Phase 9.2I). Revision recording is enabled by default for
# the certified modules (posts, pages, taxonomy terms). Recording is best-effort
# and never blocks a content/term write. To roll back, set the master switch (or
# any per-entity flag) to false and clear the config cache — no data cleanup.
# CMS_REVISIONS_ENABLED=false
# CMS_REVISIONS_POSTS=false
# CMS_REVISIONS_PAGES=false
# CMS_REVISIONS_TAXONOMY=false
